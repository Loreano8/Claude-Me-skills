# Copier ce fichier en .env pour lancer le serveur en local. En ligne, ces valeurs
# sont réglées par render.yaml (à la racine du dépôt) et dans le tableau de bord Render.

# Clé API Anthropic (https://console.anthropic.com) : utilisée par le serveur pour toutes les actions IA.
ANTHROPIC_API_KEY=
# Modèle Claude (claude-sonnet-5-5 en production).
CLAUDE_MODEL=claude-sonnet-5-5

# Base Postgres. Sans elle : pas de comptes, IA en accès libre (pratique en local).
# DATABASE_URL=postgres://...
# Secret de signature des sessions (obligatoire avec DATABASE_URL).
# SESSION_SECRET=une-longue-chaine-aleatoire
# Crédits offerts à l'inscription.
FREE_CREDITS=1

# Paiement FedaPay (https://fedapay.com) : clé secrète du tableau de bord, mode sandbox ou live.
# FEDAPAY_SECRET_KEY=sk_sandbox_...
FEDAPAY_ENV=sandbox
# Adresse publique du site (retour après paiement).
# PUBLIC_URL=https://cv-studio-932m.onrender.com
# Jeton secret pour ajouter des crédits à la main (POST /api/admin/credits).
# ADMIN_TOKEN=

PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
RATE_LIMIT_PER_HOUR=30

# Application Android : adresse du serveur en ligne (utilisée au moment du build).
# VITE_API_URL=https://cv-studio-932m.onrender.com

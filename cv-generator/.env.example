# Clé API Anthropic (https://console.anthropic.com) — nécessaire pour les fonctions IA.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé par le serveur (par défaut : claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Port du serveur API.
PORT=8787

# Origines autorisées à appeler l'API (séparées par des virgules).
# L'application Android (Capacitor) utilise https://localhost.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# Nombre maximal de requêtes IA par adresse IP et par heure.
RATE_LIMIT_PER_HOUR=30

# Pour l'application Android : URL publique de l'API (utilisée au build web).
# VITE_API_URL=https://votre-serveur.example.com
